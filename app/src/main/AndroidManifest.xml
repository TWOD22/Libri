<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso necesario para buscar libros y portadas en Open Library -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LibriApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Libri">

        <!-- Pantalla inicial: inicio de sesión con los usuarios de prueba -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla principal: Inicio, Biblioteca, Estadísticas y Perfil -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Detalle de un libro: avance, estrellas e historial -->
        <activity
            android:name=".BookDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Formulario para agregar o editar un libro -->
        <activity
            android:name=".BookFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Búsqueda de libros en internet (Open Library) -->
        <activity
            android:name=".BookSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
